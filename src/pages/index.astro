---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Catalog from '../components/Catalog.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { site, getArtists } from '../data';
import { withBase } from '../utils/paths';

const home = new URL(withBase(), Astro.site).href;
const artists = getArtists();

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  description: site.description,
  url: home,
  logo: new URL(withBase('icon-512.png'), Astro.site).href,
  email: site.contact.email,
  telephone: `+${site.contact.whatsappNumber}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.contact.city,
    addressRegion: site.contact.region,
    addressCountry: site.contact.country,
  },
  ...(site.socials.length ? { sameAs: site.socials.map((s) => s.url) } : {}),
};

const catalogList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Artistas de Melody Producciones',
  itemListElement: artists.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.name,
    url: new URL(a.url, Astro.site).href,
  })),
};
---

<BaseLayout jsonLd={[organization, catalogList]}>
  <Hero />
  <Catalog />
  <About />
  <Contact />
</BaseLayout>
