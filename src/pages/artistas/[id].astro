---
/**
 * Página individual de cada artista: /artistas/<id>/
 * Se genera un archivo HTML estático por artista (funciona al recargar en GitHub Pages).
 * Las secciones sin contenido confirmado (biografía, galería, videos, redes) se ocultan.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtistPoster from '../../components/ArtistPoster.astro';
import Gallery from '../../components/Gallery.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import Icon from '../../components/Icon.astro';
import { getArtists, site, type ResolvedArtist } from '../../data';
import { getUi } from '../../i18n';
import { withBase, homeSection } from '../../utils/paths';

export function getStaticPaths() {
  return getArtists().map((artist, index) => ({ params: { id: artist.id }, props: { artist, index } }));
}

interface Props {
  artist: ResolvedArtist;
  index: number;
}
const { artist, index } = Astro.props;
const ui = getUi();
const others = getArtists().filter((a) => a.id !== artist.id);
const bio = artist.hasBio ? (artist.bio as string[]) : [];
// Galería: fotos además de la portada (si hay una sola foto, ya se ve arriba)
const galleryImages = artist.resolvedImages.length > 1 ? artist.resolvedImages.slice(1) : [];

const description = artist.hasShortDescription
  ? `${artist.name} — ${artist.discipline}. ${artist.shortDescription} Contratación a través de ${site.name}, Rosario.`
  : `${artist.name} — ${artist.discipline}. Consultá por su contratación a través de ${site.name}, Rosario, Santa Fe.`;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(withBase(), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Artistas', item: new URL(homeSection('artistas'), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: artist.name, item: new URL(artist.url, Astro.site).href },
  ],
};
---

<BaseLayout title={`${artist.name} — ${artist.discipline}`} description={description} whatsappUrl={artist.whatsappUrl} jsonLd={[breadcrumb]}>
  <article class="artist" data-testid="artist-page" data-artist={artist.id}>
    <section class="artist-hero" aria-labelledby="artista-nombre">
      <div class="artist-hero__bg" aria-hidden="true"></div>
      <div class="container artist-hero__grid">
        <div class="artist-hero__media" data-reveal>
          <ArtistPoster artist={artist} index={index} variant="hero" loading="eager" sizes="(min-width: 60rem) 40vw, 92vw" />
        </div>

        <div class="artist-hero__info">
          <nav aria-label={ui.artist.breadcrumb} class="crumbs">
            <ol role="list">
              <li><a href={withBase()}>{ui.nav.home}</a></li>
              <li><a href={homeSection('artistas')}>{ui.nav.artists}</a></li>
              <li><span aria-current="page">{artist.name}</span></li>
            </ol>
          </nav>
          <p class="eyebrow">{artist.discipline}</p>
          <h1 id="artista-nombre" class="artist-hero__name">{artist.name}</h1>
          {artist.hasShortDescription && <p class="lead">{artist.shortDescription}</p>}

          <div class="artist-hero__actions">
            <a class="btn btn--primary" href={artist.whatsappUrl} target="_blank" rel="noopener" data-testid="artist-whatsapp">
              <Icon name="whatsapp" />
              {ui.catalog.hire}<span class="sr-only"> de {artist.name} por WhatsApp {ui.artist.opensNewTab}</span>
            </a>
            {
              artist.links.map((l) => (
                <a class="btn btn--ghost" href={l.url} target="_blank" rel="noopener" data-testid="artist-external">
                  {l.label}
                  <span class="sr-only"> {ui.artist.opensNewTab}</span>
                  <Icon name="external" />
                </a>
              ))
            }
          </div>
          <a class="text-link back" href={homeSection('artistas')}>
            <Icon name="arrow-left" size={18} />
            {ui.artist.backToCatalog}
          </a>
        </div>
      </div>
    </section>

    {
      bio.length > 0 && (
        <section class="section artist-section" aria-labelledby="bio-titulo">
          <div class="container">
            <div class="narrow" data-reveal>
              <h2 id="bio-titulo">
                {ui.artist.about} {artist.name}
              </h2>
              <div class="bio">
                {bio.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      galleryImages.length > 0 && (
        <section class="section artist-section" aria-labelledby="galeria-titulo">
          <div class="container">
            <h2 id="galeria-titulo">{ui.artist.gallery}</h2>
            <Gallery images={galleryImages} artistName={artist.name} />
          </div>
        </section>
      )
    }

    {
      artist.videos.length > 0 && (
        <section class="section artist-section" aria-labelledby="videos-titulo">
          <div class="container">
            <h2 id="videos-titulo">{ui.artist.videos}</h2>
            <ul role="list" class="videos">
              {artist.videos.map((v) => (
                <li data-reveal>
                  <VideoEmbed video={v} />
                  <p class="videos__title">{v.title}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      artist.socials.length > 0 && (
        <section class="section artist-section" aria-labelledby="redes-titulo">
          <div class="container">
            <h2 id="redes-titulo">{ui.artist.socials}</h2>
            <ul role="list" class="socials">
              {artist.socials.map((s) => (
                <li>
                  <a class="btn btn--ghost" href={s.url} target="_blank" rel="noopener">
                    {s.label}
                    <span class="sr-only"> {ui.artist.opensNewTab}</span>
                    <Icon name="external" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <section class="section hire" aria-labelledby="contratar-titulo">
      <div class="container hire__box" data-reveal>
        <h2 id="contratar-titulo">{ui.artist.hireTitle} {artist.name}?</h2>
        <p class="lead">{ui.artist.hireText}</p>
        <div class="hire__actions">
          <a class="btn btn--primary" href={artist.whatsappUrl} target="_blank" rel="noopener">
            <Icon name="whatsapp" />
            {ui.catalog.hire}<span class="sr-only"> de {artist.name} por WhatsApp {ui.artist.opensNewTab}</span>
          </a>
          <a class="btn btn--ghost" href={`mailto:${site.contact.email}?subject=${encodeURIComponent(`Consulta por ${artist.name} — Melody Producciones`)}`}>
            <Icon name="mail" />
            {ui.contact.emailAction}<span class="sr-only"> a {site.contact.email}</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section others" aria-labelledby="otros-titulo">
      <div class="container">
        <h2 id="otros-titulo">{ui.artist.otherArtists}</h2>
        <ul role="list" class="others__grid">
          {
            others.map((o) => (
              <li>
                <a class="other" href={o.url}>
                  <span class="other__media">
                    <ArtistPoster artist={o} index={getArtists().indexOf(o)} variant="mini" sizes="(min-width: 60rem) 18vw, 45vw" />
                  </span>
                  <span class="other__text">
                    <span class="other__name">{o.name}</span>
                    <span class="other__discipline">{o.discipline}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .artist-hero {
    position: relative;
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
    isolation: isolate;
    overflow: hidden;
  }
  .artist-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(70% 60% at 15% 10%, rgb(242 106 27 / 0.22), transparent 70%),
      radial-gradient(60% 60% at 90% 30%, rgb(46 125 181 / 0.3), transparent 70%),
      linear-gradient(to bottom, var(--navy-800), var(--ink-950) 85%);
    mask-image: linear-gradient(to bottom, #000 65%, transparent);
  }
  .artist-hero__grid {
    display: grid;
    gap: 2.25rem;
    align-items: center;
  }
  .artist-hero__media {
    aspect-ratio: 4 / 5;
    max-height: 56svh;
    width: 100%;
    max-width: 30rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-lg);
  }
  .artist-hero__info {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .artist-hero__name {
    font-size: var(--text-4xl);
    line-height: 1;
  }
  .artist-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    margin-top: 0.5rem;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.3rem;
    opacity: 0.6;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--color-accent-text);
    text-decoration: underline;
  }
  @media (min-width: 60rem) {
    .artist-hero {
      min-height: 72svh;
      display: grid;
      align-items: center;
    }
    .artist-hero__media {
      max-height: 75svh;
    }
    .artist-hero__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4.5rem;
    }
  }

  .artist-section {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
  }
  .artist-section h2,
  .others h2 {
    font-size: var(--text-2xl);
    margin-bottom: 1.75rem;
  }
  .narrow {
    max-width: 46rem;
  }
  .bio {
    display: grid;
    gap: 1.1rem;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  .videos {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 48rem) {
    .videos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .videos__title {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hire__box {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
    padding: clamp(2rem, 1.5rem + 3vw, 4rem) var(--gutter);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(70% 90% at 50% 120%, rgb(242 106 27 / 0.3), transparent 70%),
      linear-gradient(160deg, var(--navy-700), var(--ink-900));
    border: 1px solid var(--color-border-strong);
  }
  .hire__box h2 {
    font-size: var(--text-3xl);
  }
  .hire__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .hire__actions .btn--ghost {
    overflow-wrap: anywhere;
  }

  .others {
    padding-top: 0;
  }
  .others__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 60rem) {
    .others__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .other {
    display: grid;
    overflow: hidden;
    height: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    text-decoration: none;
    transition:
      transform var(--dur) var(--ease-out),
      border-color var(--dur);
  }
  .other:hover {
    transform: translateY(-4px);
    border-color: rgb(242 106 27 / 0.5);
  }
  .other__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .other__text {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1rem 1.1rem;
  }
  .other__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.15;
  }
  .other__discipline {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
</style>
