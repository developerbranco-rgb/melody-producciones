---
interface Props {
  eyebrow: string;
  title: string;
  id: string;
  align?: 'start' | 'center';
}
const { eyebrow, title, id, align = 'start' } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`]} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  <slot />
</header>

<style>
  .section-heading {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    max-width: 48rem;
  }
  .section-heading--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }
  h2 {
    font-size: var(--text-3xl);
  }
</style>
