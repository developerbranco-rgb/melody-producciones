---
/**
 * Vista rápida de un artista (ventana modal nativa <dialog>).
 * Se abre desde la tarjeta del catálogo. Accesible: foco atrapado por el navegador,
 * se cierra con Esc, con el botón Cerrar o haciendo clic fuera del contenido.
 */
import ArtistPoster from './ArtistPoster.astro';
import Icon from './Icon.astro';
import type { ResolvedArtist } from '../data';
import { getUi } from '../i18n';

interface Props {
  artist: ResolvedArtist;
  index: number;
}
const { artist, index } = Astro.props;
const ui = getUi();
const titleId = `vista-${artist.id}-titulo`;
---

<dialog id={`vista-${artist.id}`} class="qv" aria-labelledby={titleId} data-testid="quick-view">
  <div class="qv__panel">
    <button type="button" class="qv__close" data-dialog-close>
      <Icon name="close" />
      <span class="sr-only">{ui.catalog.closeDialog}</span>
    </button>
    <div class="qv__media">
      <ArtistPoster artist={artist} index={index} sizes="(min-width: 48rem) 22rem, 90vw" />
    </div>
    <div class="qv__content">
      <p class="qv__discipline">{artist.discipline}</p>
      <h2 id={titleId} class="qv__title">{artist.name}</h2>
      {artist.hasShortDescription && <p class="qv__desc">{artist.shortDescription}</p>}
      <div class="qv__actions">
        <a class="btn btn--primary" href={artist.whatsappUrl} target="_blank" rel="noopener" data-testid="qv-whatsapp">
          <Icon name="whatsapp" />
          {ui.catalog.hire}<span class="sr-only"> de {artist.name} por WhatsApp {ui.artist.opensNewTab}</span>
        </a>
        <a class="btn btn--ghost" href={artist.url}>
          {ui.catalog.viewProfile}<span class="sr-only"> de {artist.name}</span>
          <Icon name="arrow-right" />
        </a>
      </div>
      {
        artist.links.length > 0 && (
          <ul role="list" class="qv__links">
            {artist.links.map((l) => (
              <li>
                <a class="text-link" href={l.url} target="_blank" rel="noopener">
                  {l.label}
                  <span class="sr-only"> {ui.artist.opensNewTab}</span>
                </a>
                <Icon name="external" size={14} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</dialog>

<style>
  .qv {
    width: min(100% - 1.5rem, 46rem);
    max-height: calc(100dvh - 1.5rem);
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 40px 120px -20px rgb(0 0 0 / 0.9);
    overflow: auto;
  }
  .qv::backdrop {
    background: rgb(3 5 8 / 0.78);
    backdrop-filter: blur(6px);
  }
  .qv[open] {
    animation: qv-in var(--dur) var(--ease-out);
  }
  .qv[open]::backdrop {
    animation: fade-in var(--dur) ease;
  }
  @keyframes qv-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.97);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  .qv__panel {
    position: relative;
    display: grid;
  }
  .qv__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgb(6 8 12 / 0.75);
    border: 1px solid var(--color-border-strong);
    transition: background-color var(--dur-fast);
  }
  .qv__close:hover {
    background: var(--orange-500);
    color: var(--ink-950);
  }
  .qv__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .qv__content {
    padding: 1.5rem 1.4rem 1.75rem;
    display: grid;
    gap: 0.6rem;
    align-content: center;
  }
  .qv__discipline {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .qv__title {
    font-size: var(--text-3xl);
  }
  .qv__desc {
    color: var(--color-text-muted);
  }
  .qv__actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.8rem;
  }
  .qv__links {
    margin-top: 0.4rem;
    display: grid;
    gap: 0.3rem;
    font-size: var(--text-sm);
  }
  .qv__links li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-accent-2);
  }
  @media (min-width: 48rem) {
    .qv__panel {
      grid-template-columns: 20rem 1fr;
    }
    .qv__media {
      aspect-ratio: 4 / 5;
    }
    .qv__content {
      padding: 2.5rem 2.25rem;
    }
  }
</style>
