---
import { Image } from 'astro:assets';
import logo from '../assets/brand/originales/logo-melody-producciones.png';
import Icon from './Icon.astro';
import { site, generalWhatsappUrl } from '../data';
import { getUi } from '../i18n';
import { withBase, homeSection } from '../utils/paths';
import { buildMailto } from '../utils/whatsapp';

const ui = getUi();
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href={withBase()} class="footer__logo">
        <Image src={logo} alt={`${site.name}, ${ui.nav.home.toLowerCase()}`} width={280} widths={[280, 560]} sizes="13rem" />
      </a>
      <p>{ui.footer.tagline}</p>
      <p class="footer__muted"><Icon name="pin" size={16} /> {site.contact.location}</p>
    </div>

    <nav aria-label="Navegación del pie de página">
      <ul role="list" class="footer__links">
        <li><a href={homeSection('inicio')}>{ui.nav.home}</a></li>
        <li><a href={homeSection('artistas')}>{ui.nav.artists}</a></li>
        <li><a href={homeSection('nosotros')}>{ui.nav.about}</a></li>
        <li><a href={homeSection('contacto')}>{ui.nav.contact}</a></li>
      </ul>
    </nav>

    <ul role="list" class="footer__contact">
      <li>
        <a href={generalWhatsappUrl} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} />
          {site.contact.whatsappDisplay}<span class="sr-only"> (WhatsApp) {ui.artist.opensNewTab}</span>
        </a>
      </li>
      <li>
        <a href={buildMailto(site.contact.email)}>
          <Icon name="mail" size={18} />
          {site.contact.email}
        </a>
      </li>
      {
        site.socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener">
              <Icon name="link" size={18} />
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="container footer__bottom">
    <p>© {year} {site.name}. {ui.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: 4rem 6rem; /* espacio extra para el botón flotante */
    background: linear-gradient(to bottom, var(--ink-950), #040507);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
  .footer__grid {
    display: grid;
    gap: 2.5rem;
  }
  .footer__brand {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .footer__logo {
    display: block;
    padding: 0.9rem 1.2rem;
    border-radius: var(--radius);
    background: var(--cream-50);
    transition: transform var(--dur) var(--ease-out);
  }
  .footer__logo:hover {
    transform: translateY(-2px);
  }
  .footer__logo :global(img) {
    width: 13rem;
    height: auto;
  }
  .footer__muted {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-muted);
  }
  .footer__links,
  .footer__contact {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }
  .footer a:not(.footer__logo) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem; /* área táctil */
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--dur-fast);
  }
  .footer a:not(.footer__logo):hover {
    color: var(--color-accent-text);
  }
  .footer__bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1.2fr;
    }
  }
</style>
