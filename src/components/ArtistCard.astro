---
/**
 * Tarjeta de artista del catálogo. Todas las tarjetas tienen el mismo formato y tamaño
 * para mantener un catálogo equilibrado.
 */
import ArtistPoster from './ArtistPoster.astro';
import Icon from './Icon.astro';
import type { ResolvedArtist } from '../data';
import { getUi } from '../i18n';

interface Props {
  artist: ResolvedArtist;
  index: number;
}
const { artist, index } = Astro.props;
const ui = getUi();
---

<article class="card" data-reveal style={`--reveal-delay:${(index % 3) * 110}`} data-testid="artist-card" data-artist={artist.id}>
  <div class="card__media">
    <div class="card__poster">
      <ArtistPoster artist={artist} index={index} />
    </div>
    <span class="card__shade" aria-hidden="true"></span>
    <div class="card__caption">
      <p class="card__discipline">{artist.discipline}</p>
      <h3 class="card__title">
        <a href={artist.url} class="card__link">{artist.name}</a>
      </h3>
      {artist.hasShortDescription && <p class="card__desc">{artist.shortDescription}</p>}
    </div>
  </div>
  <div class="card__actions">
    <button type="button" class="btn btn--ghost btn--sm" data-dialog-open={`vista-${artist.id}`} aria-haspopup="dialog">
      <Icon name="eye" />
      {ui.catalog.quickView}<span class="sr-only"> de {artist.name}</span>
    </button>
    <a href={artist.url} class="btn btn--light btn--sm">
      Ver perfil<span class="sr-only"> de {artist.name}</span>
      <Icon name="arrow-right" />
    </a>
  </div>
  {
    artist.links.length > 0 && (
      <ul role="list" class="card__links">
        {artist.links.map((l) => (
          <li>
            <a class="card__site" href={l.url} target="_blank" rel="noopener" data-testid="card-external">
              <Icon name="external" size={14} />
              {l.label}
              <span class="sr-only"> {ui.artist.opensNewTab}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    isolation: isolate;
    transition:
      transform var(--dur) var(--ease-out),
      border-color var(--dur) ease,
      box-shadow var(--dur) var(--ease-out);
  }
  .card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .card__poster {
    position: absolute;
    inset: 0;
    transition: transform 1.2s var(--ease-out);
  }
  .card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 15 22 / 1) 0%, rgb(10 15 22 / 0.7) 26%, transparent 55%);
    pointer-events: none;
  }
  .card__caption {
    position: absolute;
    inset: auto 0 0;
    padding: 0 1.4rem 1rem;
    display: grid;
    gap: 0.35rem;
  }
  .card__discipline {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .card__title {
    font-size: clamp(1.6rem, 1.3rem + 0.9vw, 2.1rem);
  }
  .card__link {
    text-decoration: none;
  }
  .card__link::after {
    /* Toda la imagen de la tarjeta lleva al perfil (un solo enlace accesible) */
    content: '';
    position: absolute;
    inset: -100vh 0 0; /* cubre el área de la imagen */
  }
  .card__link:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange-500);
    text-decoration-thickness: 2px;
  }
  .card__desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0.5rem 1.4rem 1.4rem;
    margin-top: auto;
  }
  .card__actions .btn {
    flex: 1 1 8rem;
  }
  .card__links {
    margin-top: -0.6rem;
    padding: 0 1.4rem 1.35rem;
    font-size: var(--text-sm);
  }
  .card__site {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-accent-2);
    font-weight: 600;
  }
  .card__site:hover {
    color: var(--color-accent-text);
    text-decoration: underline;
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-6px);
      border-color: rgb(242 106 27 / 0.45);
      box-shadow: var(--shadow-lg), 0 0 60px -20px rgb(242 106 27 / 0.45);
    }
    .card:hover .card__poster {
      transform: scale(1.05);
    }
  }
  .card:focus-within {
    border-color: rgb(242 106 27 / 0.6);
  }
</style>
